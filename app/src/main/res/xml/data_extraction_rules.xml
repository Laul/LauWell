<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: exclude all app data from both cloud backup and device-to-device transfer.
    The app's private storage holds the Firebase session (tokens) and, later, the Room cache of
    Health Connect data; neither should leave the device. Everything that matters lives in
    Firestore / Health Connect, so after a restore or a new phone the user simply signs in again.
    android:allowBackup="false" in the manifest covers Android 11 and below.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
